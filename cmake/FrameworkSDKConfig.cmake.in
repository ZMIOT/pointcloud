@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt5 @Qt5Core_VERSION@ EXACT COMPONENTS Core)
find_dependency(PCL @PCL_VERSION@ EXACT COMPONENTS common)
find_dependency(OpenCV @OpenCV_VERSION@ EXACT COMPONENTS core imgproc)
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@" OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@" OR NOT CMAKE_SIZEOF_VOID_P EQUAL @CMAKE_SIZEOF_VOID_P@)
  message(FATAL_ERROR "FrameworkSDK requires its original compiler version and architecture")
endif()
set(FW_ABI_BASE "@FW_ABI_BASE@")
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
include("${CMAKE_CURRENT_LIST_DIR}/FrameworkSDKTargets.cmake")
set_property(TARGET Framework::SDK APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES ${PCL_INCLUDE_DIRS} ${OpenCV_INCLUDE_DIRS})
include("${CMAKE_CURRENT_LIST_DIR}/FrameworkPlugin.cmake")
