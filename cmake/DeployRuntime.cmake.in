if(NOT FW_BIN)
  message(FATAL_ERROR "Pass -DFW_BIN=<absolute bin directory>")
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@FW_COMPILER_BIN@/dumpbin.exe")
set(search_dirs "${FW_BIN}" "@FW_QT_BIN@" "@FW_PCL_ROOT@/bin" "@VTK_INSTALL_PREFIX@/bin" "@FW_OPENCV_BIN@" "@FW_PCL_ROOT@/3rdParty/OpenNI2/Redist" "@FW_PCL_ROOT@/3rdParty/FLANN/bin" "@FW_PCL_ROOT@/3rdParty/Boost/lib" @FW_RUNTIME_DIRS@)
file(GLOB_RECURSE modules "${FW_BIN}/plugins/*.dll")
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${FW_BIN}/Launcher.exe" LIBRARIES ${modules}
  DIRECTORIES ${search_dirs}
  RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
  PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
  POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32.*")
if(unresolved)
  message(FATAL_ERROR "Unresolved DLL dependencies: ${unresolved}. Set FW_RUNTIME_DIRS to their directories.")
endif()
foreach(dll IN LISTS resolved)
  file(INSTALL "${dll}" DESTINATION "${FW_BIN}" TYPE FILE)
endforeach()
set(system_runtimes "@CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS@")
foreach(runtime IN LISTS system_runtimes)
  file(INSTALL "${runtime}" DESTINATION "${FW_BIN}" TYPE FILE)
endforeach()
if(FW_CONFIG STREQUAL "Debug")
  set(mode --debug)
else()
  set(mode --release)
endif()
execute_process(COMMAND "@FW_QT_BIN@/windeployqt.exe" ${mode} --no-compiler-runtime --no-translations "${FW_BIN}/Launcher.exe" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "windeployqt failed: ${status}")
endif()
