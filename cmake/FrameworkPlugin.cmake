function(framework_add_plugin target)
  cmake_parse_arguments(P "NO_INSTALL" "TYPE;ID;ALGORITHM_ID;VERSION;PARAMETER_VERSION" "SOURCES" ${ARGN})
  if(NOT P_VERSION)
    set(P_VERSION 1.0.0)
  endif()
  if(NOT P_PARAMETER_VERSION)
    set(P_PARAMETER_VERSION 1)
  endif()
  if(NOT P_TYPE OR NOT P_ID)
    message(FATAL_ERROR "framework_add_plugin requires TYPE and ID")
  endif()
  set(meta_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}-metadata/$<CONFIG>")
  file(GENERATE OUTPUT "${meta_dir}/metadata.json" CONTENT "{\"pluginId\":\"${P_ID}\",\"algorithmId\":\"${P_ALGORITHM_ID}\",\"version\":\"${P_VERSION}\",\"parameterVersion\":${P_PARAMETER_VERSION},\"sdkVersion\":1,\"type\":\"${P_TYPE}\",\"buildId\":\"${FW_ABI_BASE}|$<IF:$<CONFIG:Debug>,Debug,Release>\"}")
  add_library(${target} MODULE ${P_SOURCES})
  set_target_properties(${target} PROPERTIES AUTOMOC ON AUTORCC ON PREFIX "" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/$<CONFIG>/plugins/${P_TYPE}" LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/$<CONFIG>/plugins/${P_TYPE}")
  target_include_directories(${target} PRIVATE "${meta_dir}")
  target_link_libraries(${target} PRIVATE Framework::SDK)
  if(MSVC)
    target_compile_options(${target} PRIVATE /utf-8 /bigobj)
    target_compile_definitions(${target} PRIVATE NOMINMAX)
  endif()
  if(NOT P_NO_INSTALL)
    install(TARGETS ${target} RUNTIME DESTINATION bin/plugins/${P_TYPE} LIBRARY DESTINATION bin/plugins/${P_TYPE})
  endif()
endfunction()
