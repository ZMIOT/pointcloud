{
  "schemaVersion": 1,
  "parameterVersion": 6,
  "algorithmId": "custom.corrugatedPanelFeature",
  "title": "波纹板竖直放置特征提取",
  "groups": [
    {
      "id": "surface_prefilter",
      "title": "轨迹提取前：板面支持滤波（输入单位，默认 mm）",
      "parameters": [
        {"id":"prefilter_enabled","type":"bool","label":"启用前置板面滤波","default":true,"description":"基准面定位后、切片与表面求交前筛选有限局部面片。保留原坐标与字段，提供保留/剔除图层。局部平面支持是几何证据，不能保证区分与真实板面重合的干扰。"},
        {"id":"prefilter_window","type":"double","label":"局部板面窗口长度","default":12.0,"min":0.1,"max":1000.0,"step":1.0,"decimals":3,"description":"沿工件长度使用75%重叠窗口；过大会混合折角或曲率，过小可能只覆盖单条扫描线。窗口须不少于表面容差的4倍。"},
        {"id":"prefilter_distance","type":"double","label":"板面保留距离","default":0.8,"min":0.001,"max":20.0,"step":0.1,"decimals":3,"description":"点到受支持局部板面的最大距离。调小会增加删除量，也可能损失真实表面。不是定位精度保证。"},
        {"id":"prefilter_min_support","type":"int","label":"面片最少采样支持","default":12,"min":6,"max":1024,"description":"每窗口每轮最多采样1024点，拟合面必须具有二维分布；密集单扫描线不算面片。"}
      ]
    },
    {
      "id": "slices",
      "title": "平行切片（输入坐标单位，默认 mm）",
      "parameters": [
        {"id":"offset_1","type":"double","label":"切片距离 1","default":10.0,"min":0.1,"max":1000.0,"step":1.0,"decimals":3},
        {"id":"offset_2","type":"double","label":"切片距离 2","default":20.0,"min":0.1,"max":1000.0,"step":1.0,"decimals":3},
        {"id":"offset_3","type":"double","label":"切片距离 3","default":30.0,"min":0.1,"max":1000.0,"step":1.0,"decimals":3},
        {"id":"slice_thickness","type":"double","label":"切片厚度","default":3.0,"min":0.05,"max":100.0,"step":0.5,"decimals":3},
        {"id":"bend_deviation","type":"double","label":"弯折判定偏差","default":2.0,"min":0.01,"max":100.0,"step":0.2,"decimals":3,"description":"切片主轴拟合后 90% 点的横向偏差达到该值才判为弯折。"},
        {"id":"trajectory_spacing","type":"double","label":"拟合前中心轨迹间距","default":2.0,"min":0.01,"max":100.0,"step":0.2,"decimals":3},
        {"id":"line_fit_tolerance","type":"double","label":"坡段拟合容差","default":3.0,"min":0.001,"max":100.0,"step":0.5,"decimals":3,"description":"一坡一段，先划分直线支持区间，再在本容差内优先选择支持点最多的直线并正交重拟合；相邻拟合直线交点作为合成拐点。也用于抑制坡内小幅斜率波动。"},
        {"id":"white_point_spacing","type":"double","label":"白色点目标间距","default":10.0,"min":0.01,"max":1000.0,"step":1.0,"decimals":3,"description":"按目标间距从特征曲线选择采样点，再统一正交投影到对应的整段拟合直线；包含全部转折点。"}
      ]
    },
    {
      "id": "filter",
      "title": "基准面与去噪",
      "parameters": [
        {"id":"plane_distance","type":"double","label":"局部 A 面内点距离","default":0.6,"min":0.001,"max":20.0,"step":0.1,"decimals":4},
        {"id":"reference_segment_length","type":"double","label":"局部基准面最大长度","default":500.0,"min":10.0,"max":100000.0,"step":50.0,"decimals":2,"description":"沿工件长度方向自动建立 A1…An；长工件允许首尾局部基准面不共面。"},
        {"id":"max_adjacent_normal_angle","type":"double","label":"相邻 A 面最大法向变化角（度）","default":15.0,"min":0.1,"max":89.0,"step":1.0,"decimals":2,"description":"相邻局部基准面的法向变化超过该值时停止，避免把突变或明显曲面静默压平。"},
        {"id":"denoise_radius","type":"double","label":"B 点云去噪半径","default":2.5,"min":0.01,"max":100.0,"step":0.2,"decimals":3},
        {"id":"min_neighbors","type":"int","label":"最少邻点数","default":3,"min":1,"max":64},
        {"id":"min_plane_points","type":"int","label":"A 面最少点数","default":200,"min":3,"max":10000000}
      ]
    },
    {
      "id": "surface_intersection",
      "title": "避开焊接边缘的主体延伸（输入单位，默认 mm）",
      "parameters": [
        {"id":"max_surface_extrapolation","type":"double","label":"主体到 A 最大延伸弧长","default":40.0,"min":0.0,"max":100.0,"step":0.5,"decimals":3,"description":"仅在离开焊接边缘的主体带内拟合。普通模型延伸不超过观测跨度；通过分条和分层方向稳定性验证的 B 附近小面片可延伸至观测跨度的 4 倍，但始终不得超过本值。不满足时按开关整线投影，投影不是交线。旧配置显式数值保留。"},
        {"id":"surface_fit_tolerance","type":"double","label":"表面截面拟合容差","default":0.6,"min":0.001,"max":20.0,"step":0.1,"decimals":3},
        {"id":"min_surface_points","type":"int","label":"表面最少支持点","default":20,"min":6,"max":100000},
        {"id":"min_intersection_angle","type":"double","label":"最小求交角（度）","default":10.0,"min":0.1,"max":89.0,"step":1.0,"decimals":2},
        {"id":"allow_projection_fallback","type":"bool","label":"求交失败时整条曲线投影回退","default":true,"description":"任一站位不能可靠求交时，将整条 B 曲线投影到对应 A 面，避免混合求交点和投影点。结果会明确标记为投影回退，不代表 S 与 A 的交线。关闭后保持严格求交并报错。"}
      ]
    },
    {
      "id": "performance",
      "title": "高级：性能",
      "advanced": true,
      "parameters": [
        {"id":"plane_iterations","type":"int","label":"RANSAC 迭代数","default":600,"min":20,"max":10000},
        {"id":"plane_candidates","type":"int","label":"候选平面数","default":6,"min":1,"max":16},
        {"id":"max_ransac_points","type":"int","label":"RANSAC 最大采样点","default":60000,"min":100,"max":1000000},
        {"id":"threads","type":"int","label":"并行线程数（0 自动）","default":0,"min":0,"max":128}
      ]
    }
  ]
}
