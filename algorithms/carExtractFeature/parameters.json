{
  "schemaVersion": 1, "parameterVersion": 1,
  "algorithmId": "custom.carExtractFeature", "title": "上层搭接边缘提取",
  "diagnostics": {
    "protocolVersion": 1, "algorithmId": "custom.carExtractFeature", "algorithmVersion": "1.0.0",
    "orderedInput": true,
    "stages": [
      {"id":"scan_recovery","label":"恢复扫描截面"},
      {"id":"isolation","label":"孤立点过滤"},
      {"id":"candidate","label":"单截面候选"},
      {"id":"surface","label":"邻截面曲面验证"},
      {"id":"selection","label":"全局轨迹选点"},
      {"id":"smoothing","label":"受约束平滑"}
    ],
    "outputs": [
      {"id":"upper_measured","targetId":"upper_lap_edge","targetLabel":"上层搭接边缘","role":"measured","geometry":"points"},
      {"id":"upper_trajectory","targetId":"upper_lap_edge","targetLabel":"上层搭接边缘","role":"fitted","geometry":"polyline"}
    ],
    "codes": [
      {"id":"no_sections","stage":"scan_recovery","defaultSeverity":"critical","label":"未恢复扫描截面"},
      {"id":"no_candidates","stage":"candidate","defaultSeverity":"warning","label":"未找到候选点"},
      {"id":"weak_step","stage":"candidate","defaultSeverity":"warning","label":"台阶证据不足"},
      {"id":"surface_rejected","stage":"surface","defaultSeverity":"warning","label":"邻截面曲面证据不足"},
      {"id":"trajectory_fragmented","stage":"selection","defaultSeverity":"info","label":"实测边缘存在多段"},
      {"id":"interpolated","stage":"smoothing","defaultSeverity":"info","label":"轨迹包含插补点"}
    ],
    "trialParameters": [
      {"id":"neighborhood_scale","stages":["surface"],"step":0.1,"maySuppressPhysicalDefect":true,"expectedChange":"邻截面曲面支持与验证结果可能变化","risk":"可能接纳错误邻域或丢失原本有效的局部","cannotFix":"不能生成缺失的扫描点，也不能修正错误的扫描方向"},
      {"id":"smoothing","stages":["smoothing"],"step":0.2,"maySuppressPhysicalDefect":true,"expectedChange":"拟合轨迹抖动和位置可能变化","risk":"可能抹平真实转折，实测边缘应保持原坐标","cannotFix":"不能修复候选漏检或错层"},
      {"id":"max_missing","stages":["smoothing"],"step":1,"maySuppressPhysicalDefect":true,"expectedChange":"短缺口的插补数量和连接可能变化","risk":"可能产生错误跨缺口连接","cannotFix":"不能填补无可靠两端证据的长缺口"}
    ]
  },
  "groups": [
    {"id":"basic", "title":"边缘与轨迹", "parameters":[
      {"id":"up_axis","type":"enum","label":"上方方向","default":"+z","options":[{"value":"+x","label":"+X"},{"value":"-x","label":"−X"},{"value":"+y","label":"+Y"},{"value":"-y","label":"−Y"},{"value":"+z","label":"+Z"},{"value":"-z","label":"−Z"}]},
      {"id":"neighborhood_scale","type":"double","label":"邻域尺度倍率","default":1.0,"min":0.5,"max":3.0,"step":0.1,"decimals":2,"description":"局部点距与截面间距自动估计；此倍率调整邻截面验证范围。"},
      {"id":"smoothing","type":"double","label":"平滑强度","default":1.0,"min":0.0,"max":4.0,"step":0.2,"decimals":2,"description":"0 为关闭，1 为中等。实测边界点始终保持原始坐标。"},
      {"id":"max_missing","type":"int","label":"最大补点截面数","default":3,"min":0,"max":3,"description":"仅补两端证据可靠且通过曲面验证的内部短缺口；0 表示不补点。"}
    ]},
    {"id":"advanced","title":"高级：扫描平面","advanced":true,"parameters":[
      {"id":"manual_scan_normal","type":"bool","label":"手动指定扫描平面法向","default":false},
      {"id":"scan_nx","type":"double","label":"法向 X","default":0.0,"min":-1.0,"max":1.0,"decimals":6,"enabledWhen":{"parameter":"manual_scan_normal","operator":"eq","value":true}},
      {"id":"scan_ny","type":"double","label":"法向 Y","default":1.0,"min":-1.0,"max":1.0,"decimals":6,"enabledWhen":{"parameter":"manual_scan_normal","operator":"eq","value":true}},
      {"id":"scan_nz","type":"double","label":"法向 Z","default":0.0,"min":-1.0,"max":1.0,"decimals":6,"enabledWhen":{"parameter":"manual_scan_normal","operator":"eq","value":true}}
    ]}
  ]
}
