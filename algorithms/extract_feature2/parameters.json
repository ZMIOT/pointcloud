          "decimals": 3
        },
        {
          "id": "surfaceIntersectionTolerance",
          "type": "double",
          "label": "面交点容差",
          "default": 10.0,
          "min": 0.001,
          "max": 10000,
          "step": 0.1,
          "decimals": 3
        },
        {
          "id": "minSurfaceClearance",
          "type": "double",
          "label": "侧面最小分离距离",
          "default": 2.0,
          "min": 0,
          "max": 10000,
          "step": 0.1,
          "decimals": 3
        },
        {
          "id": "surfaceRmsScale",
          "type": "double",
          "label": "表面 RMS 评分尺度",
          "default": 2.5,
          "min": 0.001,
          "max": 10000,
          "step": 0.1,
